# copy to .env (or export) - all optional
VISTA_YOLO=yolov8n.pt                 # COCO-pretrained start; after scripts/train_yolo.py use runs/detect/vista/weights/best.pt
VISTA_CHECKPOINT=models/resnet18_fine.pt
VISTA_STREAM_CHECKPOINT=models/resnet18_stream.pt
VISTA_GATE=auto                       # auto | rule | learned
VISTA_FINE_TAU=0.70
VISTA_STREAM_TAU=0.60
VISTA_DETECT_CONF=0.25
VISTA_KEEP_IMAGES=1
